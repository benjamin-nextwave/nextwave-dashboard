# Supabase — te vinden onder Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co

# De service-role-sleutel. Uitsluitend server-side; zet hem nooit in een
# variabele die met NEXT_PUBLIC_ begint.
SUPABASE_SERVICE_ROLE_KEY=

# De pincode waarmee je de app opent. Leeg laten betekent geen slot op de deur.
APP_PIN=
